  gap: 12px;
}

.leva-testimonial__avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, #c47bff, #7b3fff);
  color: #fff;
  font-weight: 800;
  font-size: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.leva-testimonial__name {
  font-weight: 700;
  font-size: 0.9rem;
  color: #0f0d1a;
  margin: 0;
}

.leva-testimonial__role {
  font-size: 0.8rem;
  color: #5a546e;
  margin: 0;
}

/* ══════════════════════════════════════════════
   CTA BAND
══════════════════════════════════════════════ */
.leva-cta-band {
  background: linear-gradient(120deg, #1a0845 0%, #3b1f8a 50%, #6b3fff 100%);
  padding: 80px 0;
  position: relative;
  overflow: hidden;
  text-align: center;
}

.leva-cta-band::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 55% 80% at 15% 50%, rgba(182,156,255,0.2) 0%, transparent 55%),
    radial-gradient(ellipse 40% 60% at 85% 50%, rgba(255,255,255,0.07) 0%, transparent 50%);
}

.leva-cta-band__content {
  position: relative;
  z-index: 1;
  max-width: 640px;
  margin: 0 auto;
  padding: 0 24px;
}

.leva-cta-band__tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.88);
  border-radius: 999px;
  padding: 5px 14px;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 20px;
}

.leva-cta-band__title {
  font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  font-weight: 900;
  color: #fff;
  line-height: 1.15;
  margin: 0 0 14px;
}

.leva-cta-band__sub {
  font-size: 1.05rem;
  color: rgba(255,255,255,0.7);
  margin: 0 0 36px;
  line-height: 1.6;
}

.leva-cta-band__actions {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}

.btn-leva-cta-band {
  padding: 14px 30px;
  border-radius: 16px;
  font-weight: 800;
  font-size: 1rem;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn-leva-cta-band--white {
  background: #fff;
  color: #6b3fff;
  box-shadow: 0 12px 32px rgba(0,0,0,0.18);
}

.btn-leva-cta-band--white:hover {
  transform: translateY(-2px);
  box-shadow: 0 18px 40px rgba(0,0,0,0.22);
  color: #6b3fff;
}

.btn-leva-cta-band--ghost {
  background: rgba(255,255,255,0.12);
  color: #fff;
  border: 1.5px solid rgba(255,255,255,0.25);
}

.btn-leva-cta-band--ghost:hover {
  background: rgba(255,255,255,0.2);
  color: #fff;
  transform: translateY(-1px);
}

/* ══════════════════════════════════════════════
   FOOTER
══════════════════════════════════════════════ */
.leva-footer {
  background: #0a0617;
  padding: 60px 0 32px;
  color: rgba(255,255,255,0.55);
}

.leva-footer__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

.leva-footer__top {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 48px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.leva-footer__brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
  text-decoration: none;
}

.leva-footer__logo {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  object-fit: cover;
}

.leva-footer__brand-name {
  font-size: 1.15rem;
  font-weight: 800;
  color: #fff;
}

.leva-footer__desc {
  font-size: 0.875rem;
  line-height: 1.65;
  margin: 0;
  color: rgba(255,255,255,0.45);
}

.leva-footer__col-title {
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.45);
  margin: 0 0 14px;
}

.leva-footer__links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.leva-footer__links a {
  color: rgba(255,255,255,0.6);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 500;
  transition: color 0.2s;
}

.leva-footer__links a:hover { color: #b69cff; }

.leva-footer__bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 28px;
  font-size: 0.82rem;
  flex-wrap: wrap;
  gap: 12px;
}

.leva-footer__copy {
  color: rgba(255,255,255,0.35);
  margin: 0;
}

.leva-footer__legal {
  display: flex;
  gap: 20px;
}

.leva-footer__legal a {
  color: rgba(255,255,255,0.35);
  text-decoration: none;
  transition: color 0.2s;
}

.leva-footer__legal a:hover { color: #b69cff; }

/* ══════════════════════════════════════════════
   AI CHAT WIDGET
══════════════════════════════════════════════ */
.leva-chat-widget {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 1050;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12px;
}

.leva-chat-toggle {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  border: none;
  background: linear-gradient(120deg, #7b3fff, #c47bff);
  color: #fff;
  font-size: 1.3rem;
  cursor: pointer;
  box-shadow: 0 14px 36px rgba(107,63,255,0.42);
  transition: transform 0.2s, box-shadow 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.leva-chat-toggle:hover {
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 20px 48px rgba(107,63,255,0.52);
}

.leva-chat-panel {
  width: 340px;
  background: #fff;
  border-radius: 22px;
  border: 1px solid rgba(182,156,255,0.2);
  box-shadow: 0 24px 64px rgba(30,15,80,0.18);
  padding: 20px;
  transform: translateY(12px);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s, transform 0.25s;
}

.leva-chat-panel.is-open {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.leva-chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.leva-chat-title {
  font-size: 0.95rem;
  font-weight: 800;
  color: #0f0d1a;
  margin: 0;
}

.leva-chat-close {
  background: none;
  border: none;
  color: #aaa;
  cursor: pointer;
  font-size: 1rem;
  line-height: 1;
  padding: 0;
}

.leva-chat-messages {
  max-height: 200px;
  overflow-y: auto;
  margin-bottom: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.leva-chat-msg {
  padding: 10px 13px;
  border-radius: 14px;
  font-size: 0.875rem;
  line-height: 1.5;
  max-width: 88%;
}

.leva-chat-msg--bot {
  background: #f3eeff;
  color: #2f2c4a;
  align-self: flex-start;
  border-bottom-left-radius: 4px;
}

.leva-chat-msg--user {
  background: linear-gradient(120deg, #7b3fff, #b46bff);
  color: #fff;
  align-self: flex-end;
  border-bottom-right-radius: 4px;
}

.leva-chat-input-row {
  display: flex;
  gap: 8px;
}

.leva-chat-textarea {
  flex: 1;
  border: 1.5px solid rgba(182,156,255,0.3);
  border-radius: 14px;
  padding: 10px 13px;
  font-size: 0.875rem;
  resize: none;
  min-height: 60px;
  color: #0f0d1a;
  outline: none;
  transition: border-color 0.2s;
}

.leva-chat-textarea:focus {
  border-color: #9d84ff;
  box-shadow: 0 0 0 3px rgba(182,156,255,0.18);
}

.leva-chat-send {
  width: 44px;
  height: 44px;
  border-radius: 13px;
  border: none;
  background: linear-gradient(120deg, #7b3fff, #b46bff);
  color: #fff;
  cursor: pointer;
  font-size: 1rem;
  align-self: flex-end;
  transition: transform 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.leva-chat-send:hover { transform: scale(1.07); }
.leva-chat-send:disabled { opacity: 0.5; cursor: not-allowed; }

/* ══════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════ */
@media (max-width: 992px) {
  .leva-hero__container { grid-template-columns: 1fr; gap: 40px; }
  .leva-hero__visual { max-width: 480px; margin: 0 auto; }
  .leva-stats__grid { grid-template-columns: repeat(2, 1fr); }
  .leva-how__steps { grid-template-columns: 1fr; }
  .leva-how__steps::before { display: none; }
  .leva-features__grid { grid-template-columns: 1fr 1fr; }
  .leva-roles__panel.is-active { grid-template-columns: 1fr; }
  .leva-map-wrap { grid-template-columns: 1fr; }
  .leva-doctors__grid { grid-template-columns: 1fr 1fr; }
  .leva-testimonials__grid { grid-template-columns: 1fr 1fr; }
  .leva-footer__top { grid-template-columns: 1fr 1fr; gap: 32px; }
}

@media (max-width: 640px) {
  .leva-nav__links { display: none; }
  .leva-hero { padding: 40px 0 32px; }
  .leva-stats__grid { grid-template-columns: 1fr 1fr; }
  .leva-features__grid { grid-template-columns: 1fr; }
  .leva-doctors__grid { grid-template-columns: 1fr; }
  .leva-testimonials__grid { grid-template-columns: 1fr; }
  .leva-float-chip--tl, .leva-float-chip--br, .leva-float-chip--tr { display: none; }
  .leva-footer__top { grid-template-columns: 1fr; }
  .leva-chat-panel { width: calc(100vw - 32px); }
}
</style>

