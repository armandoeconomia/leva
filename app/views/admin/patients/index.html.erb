<% content_for :page_title do %>
  Recepción · Pacientes
<% end %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-user-injured"></i> Pacientes</span>
    <h1 class="panel-page-title">Pacientes registrados</h1>
    <p class="panel-page-description">Visualiza y gestiona el listado de pacientes de la clínica.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Registrar paciente", new_admin_patient_path, class: "btn-panel-primary" %>
    <%= link_to "Ver doctores", admin_doctors_path, class: "btn-panel-ghost" %>
  </div>
</div>

<div class="panel-card">
  <% if @patients.any? %>
    <div class="panel-table-wrapper">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Paciente</th>
            <th>Correo</th>
            <th>Tipo de sangre</th>
            <th>Seguro médico</th>
            <th>Contacto emergencia</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @patients.each do |patient| %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:10px;">
                  <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#b69cff,#6d4ec2);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.8rem;flex-shrink:0;">
                    <%= patient.user&.name&.first&.upcase %>
                  </div>
                  <div>
                    <strong><%= patient.user&.name %> <%= patient.user&.last_name %></strong><br>
                    <small style="color:#6f6f6f;"><%= patient.user&.phone_number.presence || "Sin tel." %></small>
                  </div>
                </div>
              </td>
              <td><%= patient.user&.email %></td>
              <td>
                <span class="status-pill pendiente" style="<%= patient.blood_type.present? ? '' : 'opacity:.5' %>">
                  <%= patient.blood_type.present? ? patient.blood_type.upcase : "N/D" %>
                </span>
              </td>
              <td><%= patient.medical_insurance.presence || "—" %></td>
              <td><%= patient.emergency_contact.presence || "—" %></td>
              <td>
                <div style="display:flex;gap:6px;justify-content:flex-end;">
                  <%= link_to "Ver", admin_patient_path(patient), class: "btn-panel-link" %>
                  <%= link_to "Editar", edit_admin_patient_path(patient), class: "btn-panel-ghost", style: "padding:6px 12px;font-size:.8rem;" %>
                  <%= button_to "Eliminar",
                                admin_patient_path(patient),
                                method: :delete,
                                data: { confirm: "¿Seguro que deseas eliminar este paciente?" },
                                class: "btn-panel-danger",
                                style: "padding:6px 12px;font-size:.8rem;" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div style="text-align:center;padding:48px 0;color:#aaa;">
      <i class="fa fa-user-injured" style="font-size:2.5rem;margin-bottom:12px;display:block;"></i>
      <p style="margin:0;">No hay pacientes registrados todavía.</p>
    </div>
  <% end %>
</div>
