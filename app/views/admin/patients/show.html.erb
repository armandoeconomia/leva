<% content_for :page_title do %>
  Recepción · Paciente
<% end %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-user-injured"></i> Pacientes</span>
    <h1 class="panel-page-title"><%= @patient.user&.name %> <%= @patient.user&.last_name %></h1>
    <p class="panel-page-description">Ficha clínica del paciente. Visualiza datos, contactos y antecedentes.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Editar", edit_admin_patient_path(@patient), class: "btn-panel-primary" %>
    <%= link_to "Volver al listado", admin_patients_path, class: "btn-panel-ghost" %>
  </div>
</div>

<div class="panel-card">
  <div class="panel-card__header">
    <div>
      <span class="panel-eyebrow"><i class="fa fa-id-card"></i> Datos clínicos</span>
    </div>
    <span class="status-pill pendiente">
      <%= @patient.blood_type.present? ? @patient.blood_type.upcase : "Sin tipo de sangre" %>
    </span>
  </div>

  <div class="panel-details">
    <div class="panel-detail-item">
      <p class="panel-detail-label">Correo</p>
      <p class="panel-detail-value"><%= @patient.user&.email %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Teléfono</p>
      <p class="panel-detail-value"><%= @patient.user&.phone_number.presence || "Sin registro" %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Contacto de emergencia</p>
      <p class="panel-detail-value"><%= @patient.emergency_contact.presence || "Sin registro" %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Seguro médico</p>
      <p class="panel-detail-value"><%= @patient.medical_insurance.presence || "Sin registro" %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Estado civil</p>
      <p class="panel-detail-value"><%= @patient.marital_status&.humanize || "No definido" %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Pagos acumulados</p>
      <p class="panel-detail-value"><%= number_to_currency(@patient.payments || 0, unit: "$") %></p>
    </div>
    <div class="panel-detail-item panel-detail-item--full">
      <p class="panel-detail-label">Alergias</p>
      <div class="panel-detail-value"><%= simple_format(@patient.allergies.presence || "Sin información") %></div>
    </div>
    <div class="panel-detail-item panel-detail-item--full">
      <p class="panel-detail-label">Historial médico</p>
      <div class="panel-detail-value"><%= simple_format(@patient.medical_history.presence || "Sin información") %></div>
    </div>
    <div class="panel-detail-item panel-detail-item--full">
      <p class="panel-detail-label">Patología</p>
      <div class="panel-detail-value"><%= simple_format(@patient.pathology.presence || "Sin información") %></div>
    </div>
  </div>
</div>
