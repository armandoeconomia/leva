<% content_for :page_title do %>
  Recepción · Dashboard
<% end %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-calendar-check"></i> Recepción</span>
    <h1 class="panel-page-title">Panel de recepción</h1>
    <p class="panel-page-description">
      Gestiona la agenda de citas, coordina pacientes y doctores para el día de hoy.
    </p>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <%= link_to "Nueva cita", new_admin_appointment_path, class: "btn-panel-primary" %>
    <%= link_to "Crear usuario", new_admin_user_path, class: "btn-panel-ghost" %>
  </div>
</div>

<!-- KPIs -->
<div class="panel-metrics">
  <div class="panel-metric panel-metric--accent">
    <div class="panel-metric__icon">
      <i class="fa fa-calendar-day"></i>
    </div>
    <p class="panel-metric__value"><%= @appointments_today %></p>
    <p class="panel-metric__label">Citas hoy</p>
  </div>
  <div class="panel-metric panel-metric--warning">
    <div class="panel-metric__icon" style="background:rgba(255,202,58,0.18);color:#a07900;">
      <i class="fa fa-clock"></i>
    </div>
    <p class="panel-metric__value"><%= @appointments_pending %></p>
    <p class="panel-metric__label">Citas pendientes</p>
  </div>
  <div class="panel-metric panel-metric--success">
    <div class="panel-metric__icon" style="background:rgba(93,211,158,0.18);color:#2ea87a;">
      <i class="fa fa-user-injured"></i>
    </div>
    <p class="panel-metric__value"><%= @total_patients %></p>
    <p class="panel-metric__label">Pacientes registrados</p>
  </div>
  <div class="panel-metric">
    <div class="panel-metric__icon">
      <i class="fa fa-user-doctor"></i>
    </div>
    <p class="panel-metric__value"><%= @total_doctors %></p>
    <p class="panel-metric__label">Doctores activos</p>
  </div>
</div>

<!-- Agenda de hoy -->
<div class="panel-card">
  <div class="panel-card__header">
    <div>
      <span class="panel-eyebrow"><i class="fa fa-sun"></i> Hoy</span>
      <h2 class="panel-card__title">Agenda de hoy</h2>
      <p class="panel-card__description"><%= l(Date.today, format: "%A, %d de %B de %Y") %></p>
    </div>
    <%= link_to "Ver agenda completa", admin_appointments_path, class: "btn-panel-ghost" %>
  </div>

  <% if @todays_appointments.any? %>
    <div class="panel-table-wrapper">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Hora</th>
            <th>Paciente</th>
            <th>Doctor</th>
            <th>Motivo</th>
            <th class="text-center">Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @todays_appointments.each do |appt| %>
            <tr>
              <td><strong><%= appt.hour&.strftime('%H:%M') || '—' %></strong></td>
              <td>
                <strong><%= appt.patient&.user&.name %> <%= appt.patient&.user&.last_name %></strong><br>
                <small style="color:#6f6f6f;"><%= appt.patient&.user&.phone_number.presence || "Sin tel." %></small>
              </td>
              <td>
                Dr. <%= appt.doctor&.user&.name %> <%= appt.doctor&.user&.last_name %>
              </td>
              <td><%= appt.reason_for_consultation.presence || "—" %></td>
              <td class="text-center">
                <span class="status-pill <%= appt.status %>">
                  <%= appt.status&.humanize %>
                </span>
              </td>
              <td>
                <%= link_to "Ver", admin_appointment_path(appt), class: "btn-panel-link" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div style="text-align:center; padding:32px 0; color:#aaa;">
      <i class="fa fa-calendar" style="font-size:2rem; margin-bottom:10px; display:block;"></i>
      No hay citas programadas para hoy.
    </div>
  <% end %>
</div>

<!-- Próximas citas -->
<% if @upcoming_appointments.any? %>
  <div class="panel-card" style="margin-top:20px;">
    <div class="panel-card__header">
      <div>
        <span class="panel-eyebrow"><i class="fa fa-calendar-alt"></i> Próximas</span>
        <h2 class="panel-card__title">Próximas reservas</h2>
        <p class="panel-card__description">Citas programadas para los próximos días.</p>
      </div>
      <%= link_to "Ver todas", admin_appointments_path, class: "btn-panel-ghost" %>
    </div>
    <div class="panel-table-wrapper">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Paciente</th>
            <th>Doctor</th>
            <th class="text-center">Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @upcoming_appointments.each do |appt| %>
            <tr>
              <td><%= appt.date&.strftime('%d/%m/%Y') %></td>
              <td><%= appt.hour&.strftime('%H:%M') || '—' %></td>
              <td><strong><%= appt.patient&.user&.name %> <%= appt.patient&.user&.last_name %></strong></td>
              <td>Dr. <%= appt.doctor&.user&.name %> <%= appt.doctor&.user&.last_name %></td>
              <td class="text-center">
                <span class="status-pill <%= appt.status %>"><%= appt.status&.humanize %></span>
              </td>
              <td>
                <%= link_to "Ver", admin_appointment_path(appt), class: "btn-panel-link" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<!-- Pacientes recientes y Doctores -->
<div class="d-flex gap-4 flex-wrap" style="margin-top:20px;">
  <!-- Últimos pacientes -->
  <div class="panel-card flex-fill" style="min-width:300px;">
    <div class="panel-card__header">
      <div>
        <span class="panel-eyebrow"><i class="fa fa-user-injured"></i> Pacientes</span>
        <h2 class="panel-card__title">Últimos registros</h2>
      </div>
      <%= link_to "Ver todos", admin_patients_path, class: "btn-panel-ghost" %>
    </div>
    <% if @recent_patients.any? %>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <% @recent_patients.each do |patient| %>
          <div style="display:flex;align-items:center;gap:12px;padding:10px 14px;background:#f8f7f9;border-radius:12px;">
            <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#b69cff,#6d4ec2);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.875rem;flex-shrink:0;">
              <%= patient.user&.name&.first&.upcase %>
            </div>
            <div style="flex:1;min-width:0;">
              <p style="margin:0;font-weight:600;font-size:.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= patient.user&.name %> <%= patient.user&.last_name %></p>
              <p style="margin:0;font-size:.8rem;color:#6f6f6f;"><%= patient.user&.email %></p>
            </div>
            <%= link_to "Ver", admin_patient_path(patient), class: "btn-panel-link" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p style="color:#aaa;margin:0;text-align:center;">Sin pacientes registrados.</p>
    <% end %>
  </div>

  <!-- Doctores -->
  <div class="panel-card flex-fill" style="min-width:300px;">
    <div class="panel-card__header">
      <div>
        <span class="panel-eyebrow"><i class="fa fa-user-doctor"></i> Doctores</span>
        <h2 class="panel-card__title">Plantilla médica</h2>
      </div>
      <%= link_to "Ver todos", admin_doctors_path, class: "btn-panel-ghost" %>
    </div>
    <% if @doctors.any? %>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <% @doctors.first(5).each do |doctor| %>
          <div style="display:flex;align-items:center;gap:12px;padding:10px 14px;background:#f8f7f9;border-radius:12px;">
            <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#5dd39e,#2ea87a);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.875rem;flex-shrink:0;">
              <%= doctor.user&.name&.first&.upcase %>
            </div>
            <div style="flex:1;min-width:0;">
              <p style="margin:0;font-weight:600;font-size:.9rem;">Dr. <%= doctor.user&.name %> <%= doctor.user&.last_name %></p>
              <p style="margin:0;font-size:.8rem;color:#6f6f6f;"><%= doctor.speciality&.humanize %></p>
            </div>
            <%= link_to "Ver", admin_doctor_path(doctor), class: "btn-panel-link" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p style="color:#aaa;margin:0;text-align:center;">Sin doctores registrados.</p>
    <% end %>
  </div>
</div>
