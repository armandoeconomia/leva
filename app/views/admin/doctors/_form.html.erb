<div class="panel-card">
  <%= form_with model: [:admin, @doctor], local: true, html: { class: "panel-form" } do |f| %>
    <% if @doctor.errors.any? %>
      <div style="border-radius:12px;padding:14px 18px;background:rgba(#e74c3c,.08);color:#a44545;font-weight:600;border:1px solid rgba(#e74c3c,.15);">
        Revisa los siguientes campos:
        <ul style="margin:8px 0 0 18px;padding:0;color:#666;font-weight:500;">
          <% @doctor.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :user_id, "Usuario (email)" %>
      <%= f.collection_select :user_id,
                              User.all,
                              :id,
                              :email,
                              { prompt: "Selecciona usuario" } %>
    </div>

    <div>
      <%= f.label :medical_institute_id, "Instituto médico" %>
      <%= f.collection_select :medical_institute_id,
                              MedicalInstitute.all,
                              :id,
                              :name,
                              { prompt: "Selecciona instituto" } %>
    </div>

    <div>
      <%= f.label :speciality, "Especialidad" %>
      <%= f.select :speciality,
                   Doctor.specialities.keys.map { |s| [s.humanize, s] },
                   { prompt: "Selecciona especialidad" } %>
    </div>

    <div>
      <%= f.label :medical_registration, "Licencia médica" %>
      <%= f.text_field :medical_registration, placeholder: "Número de colegiado" %>
    </div>

    <div class="panel-form-actions">
      <%= f.submit "Guardar doctor", class: "btn-panel-primary" %>
      <%= link_to "Cancelar", admin_doctors_path, class: "btn-panel-ghost" %>
    </div>
  <% end %>
</div>
