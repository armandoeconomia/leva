<% content_for :page_title do %>
  Recepción · Doctores
<% end %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-user-doctor"></i> Doctores</span>
    <h1 class="panel-page-title">Plantilla médica</h1>
    <p class="panel-page-description">Gestiona los doctores y su asignación a sedes e institutos.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Agregar doctor", new_admin_doctor_path, class: "btn-panel-primary" %>
    <%= link_to "Ver pacientes", admin_patients_path, class: "btn-panel-ghost" %>
  </div>
</div>

<div class="panel-card">
  <% if @doctors.any? %>
    <div class="panel-table-wrapper">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Doctor</th>
            <th>Correo</th>
            <th>Instituto</th>
            <th>Especialidad</th>
            <th>Registro médico</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @doctors.each do |doctor| %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:10px;">
                  <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#5dd39e,#2ea87a);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.8rem;flex-shrink:0;">
                    <%= doctor.user.name.first.upcase %>
                  </div>
                  <div>
                    <strong>Dr. <%= doctor.user.name %> <%= doctor.user.last_name %></strong>
                  </div>
                </div>
              </td>
              <td><%= doctor.user.email %></td>
              <td><%= doctor.medical_institute&.name || "—" %></td>
              <td>
                <span class="status-pill completado" style="<%= doctor.speciality.blank? ? 'opacity:.5' : '' %>">
                  <%= doctor.speciality.present? ? doctor.speciality.humanize : "Sin especialidad" %>
                </span>
              </td>
              <td><%= doctor.medical_registration.presence || "—" %></td>
              <td>
                <div style="display:flex;gap:6px;justify-content:flex-end;">
                  <%= link_to "Ver", admin_doctor_path(doctor), class: "btn-panel-link" %>
                  <%= link_to "Editar", edit_admin_doctor_path(doctor), class: "btn-panel-ghost", style: "padding:6px 12px;font-size:.8rem;" %>
                  <%= button_to "Eliminar",
                                admin_doctor_path(doctor),
                                method: :delete,
                                data: { confirm: "¿Eliminar este doctor?" },
                                class: "btn-panel-danger",
                                style: "padding:6px 12px;font-size:.8rem;" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div style="text-align:center;padding:48px 0;color:#aaa;">
      <i class="fa fa-user-doctor" style="font-size:2.5rem;margin-bottom:12px;display:block;"></i>
      <p style="margin:0;">No hay doctores registrados todavía.</p>
    </div>
  <% end %>
</div>
