<% content_for :page_title do %>
  Recepción · Agenda de Citas
<% end %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-calendar-check"></i> Agenda</span>
    <h1 class="panel-page-title">Citas programadas</h1>
    <p class="panel-page-description">Gestiona toda la agenda de citas de la clínica.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Nueva cita", new_admin_appointment_path, class: "btn-panel-primary" %>
    <%= link_to "Dashboard", admin_dashboard_path, class: "btn-panel-ghost" %>
  </div>
</div>

<!-- Filtros -->
<div class="panel-card">
  <%= form_with url: admin_appointments_path, method: :get, local: true do %>
    <div class="panel-form-grid">
      <div>
        <label for="patient_query">Paciente</label>
        <%= text_field_tag :patient_query, @filter_params[:patient_query],
                           placeholder: "Nombre o correo",
                           class: "login-input",
                           style: "padding: 10px 14px;" %>
      </div>
      <div>
        <label for="doctor_query">Doctor</label>
        <%= text_field_tag :doctor_query, @filter_params[:doctor_query],
                           placeholder: "Nombre",
                           class: "login-input",
                           style: "padding: 10px 14px;" %>
      </div>
      <div>
        <label for="date_from">Desde</label>
        <%= date_field_tag :date_from, @filter_params[:date_from],
                           class: "login-input",
                           style: "padding: 10px 14px;" %>
      </div>
      <div>
        <label for="date_to">Hasta</label>
        <%= date_field_tag :date_to, @filter_params[:date_to],
                           class: "login-input",
                           style: "padding: 10px 14px;" %>
      </div>
      <div>
        <label for="hour">Hora</label>
        <%= time_field_tag :hour, @filter_params[:hour],
                           class: "login-input",
                           style: "padding: 10px 14px;" %>
      </div>
    </div>
    <div class="panel-form-actions" style="margin-top:12px;">
      <%= submit_tag "Filtrar", class: "btn-panel-primary" %>
      <% if @filter_params.to_h.values.any?(&:present?) %>
        <%= link_to "Limpiar", admin_appointments_path, class: "btn-panel-ghost" %>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Tabla -->
<div class="panel-card" style="margin-top:16px;">
  <% if @appointments.any? %>
    <div class="panel-table-wrapper">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Paciente</th>
            <th>Doctor</th>
            <th>Fecha</th>
            <th>Hora</th>
            <th class="text-center">Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @appointments.each do |appt| %>
            <% pu = appt.patient&.user %>
            <% du = appt.doctor&.user %>
            <tr>
              <td>
                <strong><%= pu&.name %> <%= pu&.last_name %></strong><br>
                <small style="color:#6f6f6f;"><%= pu&.email %></small>
              </td>
              <td>
                Dr. <%= du&.name %> <%= du&.last_name %><br>
                <small style="color:#6f6f6f;"><%= appt.doctor&.speciality&.humanize %></small>
              </td>
              <td><%= l(appt.date) if appt.date %></td>
              <td><%= appt.hour&.strftime("%H:%M") || "—" %></td>
              <td class="text-center">
                <% status_class = case appt.status
                                  when "completado" then "completado"
                                  when "cancelado" then "cancelado"
                                  else "pendiente" end %>
                <span class="status-pill <%= status_class %>"><%= appt.status&.humanize %></span>
              </td>
              <td>
                <div style="display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap;">
                  <%= link_to "Ver", admin_appointment_path(appt), class: "btn-panel-link" %>
                  <%= link_to "Editar", edit_admin_appointment_path(appt), class: "btn-panel-ghost", style: "padding:6px 12px;font-size:.8rem;" %>
                  <%= button_to "Eliminar",
                                admin_appointment_path(appt),
                                method: :delete,
                                data: { confirm: "¿Eliminar esta cita?" },
                                class: "btn-panel-danger",
                                style: "padding:6px 12px;font-size:.8rem;" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div style="text-align:center;padding:48px 0;color:#aaa;">
      <i class="fa fa-calendar" style="font-size:2.5rem;margin-bottom:12px;display:block;"></i>
      <p style="margin:0;">No hay citas que coincidan con los filtros.</p>
    </div>
  <% end %>
</div>
