<% content_for :page_title do %>
  Recepción · Usuario
<% end %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-user"></i> Usuarios</span>
    <h1 class="panel-page-title"><%= @user.name %> <%= @user.last_name %></h1>
    <p class="panel-page-description">Ficha del usuario. Información de contacto y acceso dentro del sistema.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Editar", edit_admin_user_path(@user), class: "btn-panel-primary" %>
    <%= link_to "Volver al listado", admin_users_path, class: "btn-panel-ghost" %>
  </div>
</div>

<div class="panel-card">
  <div class="panel-card__header">
    <div>
      <span class="panel-eyebrow"><i class="fa fa-id-badge"></i> Perfil</span>
    </div>
    <span class="status-pill <%= @user.admin? || @user.gerente? ? 'completado' : 'pendiente' %>">
      <% if @user.gerente? %>Gerente
      <% elsif @user.admin? %>Administrador
      <% elsif @user.doctor.present? %>Doctor
      <% else %>Usuario estándar
      <% end %>
    </span>
  </div>

  <div class="panel-details">
    <div class="panel-detail-item">
      <p class="panel-detail-label">Correo</p>
      <p class="panel-detail-value"><%= @user.email %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Teléfono</p>
      <p class="panel-detail-value"><%= @user.phone_number.presence || "Sin número" %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Género</p>
      <p class="panel-detail-value"><%= @user.gender&.humanize || "No especificado" %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Miembro desde</p>
      <p class="panel-detail-value"><%= @user.created_at.strftime("%d %b %Y") %></p>
    </div>
  </div>
</div>
