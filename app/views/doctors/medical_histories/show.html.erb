<% content_for :page_title do %>
  Doctor · Historiales Médicos
<% end %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-notes-medical"></i> Historiales</span>
    <h1 class="panel-page-title">Historiales de <%= @patient.user&.name || "Paciente ##{@patient.id}" %></h1>
    <p class="panel-page-description">Registros médicos del paciente. Selecciona uno para ver su detalle.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Ver paciente", doctors_patient_path(@patient), class: "btn-panel-ghost" %>
    <%= link_to "Mis pacientes", doctors_patients_path, class: "btn-panel-ghost" %>
  </div>
</div>

<% if @history.present? && @history.patient_id == @patient.id %>
<div class="panel-card">
  <div class="panel-card__header">
    <div>
      <span class="panel-eyebrow"><i class="fa fa-file-medical"></i> Detalle</span>
      <h2 class="panel-card__title"><%= @history.registration_date&.strftime('%d %b %Y') || "Sin fecha" %></h2>
      <p class="panel-card__description">Diagnóstico y tratamiento seleccionados.</p>
    </div>
    <span class="status-pill completado"><%= @history.doctor&.user&.name || "Doctor" %></span>
  </div>

  <div class="panel-details">
    <div class="panel-detail-item panel-detail-item--full">
      <p class="panel-detail-label">Diagnóstico</p>
      <p class="panel-detail-value"><%= @history.diagnosis.presence || "Sin diagnóstico" %></p>
    </div>
    <div class="panel-detail-item panel-detail-item--full">
      <p class="panel-detail-label">Tratamiento</p>
      <p class="panel-detail-value"><%= @history.treatment.presence || "Sin tratamiento" %></p>
    </div>
    <div class="panel-detail-item panel-detail-item--full">
      <p class="panel-detail-label">Prescripción</p>
      <p class="panel-detail-value"><%= @history.prescription.presence || "Sin prescripción" %></p>
    </div>
  </div>
</div>
<% else %>
<div class="panel-card">
  <div style="text-align:center;padding:32px 0;color:#aaa;">
    <i class="fa fa-notes-medical" style="font-size:2rem;margin-bottom:10px;display:block;"></i>
    <p style="margin:0 0 16px;">Este paciente no cuenta con historial médico.</p>
    <%= link_to "Ver historiales de otros pacientes",
                doctors_patient_medical_history_path(@patient, 0, show_others: true),
                class: "btn-panel-ghost" %>
  </div>
</div>
<% end %>

<div class="panel-card">
  <div class="panel-card__header">
    <div>
      <span class="panel-eyebrow"><i class="fa fa-list"></i> Listado</span>
      <h2 class="panel-card__title">Todos los historiales</h2>
      <p class="panel-card__description">Selecciona cualquier registro para ver su detalle completo.</p>
    </div>
  </div>

  <% if @histories.any? %>
    <div class="panel-table-wrapper">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Doctor</th>
            <th>Diagnóstico</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @histories.each do |history| %>
            <tr>
              <td><%= history.registration_date&.strftime('%d %b %Y') || "Sin fecha" %></td>
              <td><%= history.doctor&.user&.name || "Doctor" %></td>
              <td style="color:#888;"><%= truncate(history.diagnosis, length: 80) %></td>
              <td>
                <%= link_to "Ver", doctors_patient_medical_history_path(@patient, history), class: "btn-panel-link" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div style="text-align:center;padding:24px 0;color:#aaa;">
      <p style="margin:0 0 12px;">Este paciente no tiene historiales médicos.</p>
      <%= link_to "Ver historiales de otros pacientes",
                  doctors_patient_medical_history_path(@patient, params[:id] || 0, show_others: true),
                  class: "btn-panel-ghost" %>
    </div>
  <% end %>
</div>

<% if @other_histories.present? %>
<div class="panel-card">
  <div class="panel-card__header">
    <div>
      <span class="panel-eyebrow"><i class="fa fa-users"></i> Otros pacientes</span>
      <h2 class="panel-card__title">Historiales recientes</h2>
      <p class="panel-card__description">Referencias de otros pacientes (solo lectura).</p>
    </div>
  </div>

  <div class="panel-table-wrapper">
    <table class="panel-table">
      <thead>
        <tr>
          <th>Paciente</th>
          <th>Fecha</th>
          <th>Diagnóstico</th>
        </tr>
      </thead>
      <tbody>
        <% @other_histories.each do |history| %>
          <tr>
            <td><%= history.patient&.user&.name || "Paciente" %></td>
            <td><%= history.registration_date&.strftime('%d %b %Y') || "Sin fecha" %></td>
            <td style="color:#888;"><%= truncate(history.diagnosis, length: 80) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% end %>
