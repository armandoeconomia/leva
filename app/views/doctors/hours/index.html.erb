<% content_for :page_title do %>
  Doctor · Horarios
<% end %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-clock"></i> Disponibilidad</span>
    <h1 class="panel-page-title">Gestionar horarios</h1>
    <p class="panel-page-description">Define los días y rangos de hora en los que puedes atender pacientes.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Ver calendario", doctors_calendars_path, class: "btn-panel-ghost" %>
    <%= link_to "Agregar día", new_doctors_calendar_path, class: "btn-panel-primary" %>
  </div>
</div>

<div class="panel-card">
  <% if @calendars.any? %>
    <div class="panel-table-wrapper">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Rango de horas</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @calendars.each do |calendar| %>
            <% hours = calendar.hours.order(:start_time) %>
            <% range_label = if hours.any?
                                "#{hours.first.start_time.strftime('%H:%M')} – #{hours.last.end_time.strftime('%H:%M')}"
                              else
                                "Sin horas configuradas"
                              end %>
            <tr>
              <td><strong><%= l(calendar.date, format: :long) rescue calendar.date %></strong></td>
              <td>
                <span class="status-pill <%= hours.any? ? 'completado' : 'pendiente' %>">
                  <%= range_label %>
                </span>
              </td>
              <td>
                <div style="display:flex;gap:6px;justify-content:flex-end;">
                  <%= link_to "Agregar horas", new_doctors_calendar_hour_path(calendar), class: "btn-panel-link" %>
                  <%= button_to "Bloquear día", doctors_calendar_path(calendar),
                                method: :delete,
                                data: { confirm: "¿Eliminar/bloquear este día completo?" },
                                class: "btn-panel-danger",
                                style: "padding:6px 12px;font-size:.8rem;" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:16px;">
      <% if @prev_page %>
        <%= link_to "← Anterior", doctors_hours_path(page: @prev_page), class: "btn-panel-ghost", style: "padding:6px 14px;font-size:.85rem;" %>
      <% else %>
        <span></span>
      <% end %>
      <% if @next_page %>
        <%= link_to "Siguiente →", doctors_hours_path(page: @next_page), class: "btn-panel-ghost", style: "padding:6px 14px;font-size:.85rem;" %>
      <% end %>
    </div>
  <% else %>
    <div style="text-align:center;padding:48px 0;color:#aaa;">
      <i class="fa fa-clock" style="font-size:2.5rem;margin-bottom:12px;display:block;"></i>
      <p style="margin:0 0 16px;">Aún no has creado días en tu calendario.</p>
      <%= link_to "Crear primer día", new_doctors_calendar_path, class: "btn-panel-primary" %>
    </div>
  <% end %>
</div>
