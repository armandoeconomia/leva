<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-calendar-check"></i> Citas</span>
    <h1 class="panel-page-title">Cita actualizada</h1>
    <p class="panel-page-description">Los cambios se guardaron correctamente.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Volver al listado", doctors_appointments_path, class: "btn-panel-ghost" %>
  </div>
</div>

<div class="panel-card" style="text-align:center;padding:48px;">
  <i class="fa fa-circle-check" style="font-size:3rem;color:#2ea87a;margin-bottom:16px;display:block;"></i>
  <p style="color:#888;margin-bottom:24px;">Los cambios se guardaron correctamente.</p>
  <div style="display:flex;justify-content:center;gap:10px;">
    <%= link_to "Ver detalle", doctors_appointment_path(@appointment), class: "btn-panel-primary" %>
    <%= link_to "Ir al listado", doctors_appointments_path, class: "btn-panel-ghost" %>
  </div>
</div>
