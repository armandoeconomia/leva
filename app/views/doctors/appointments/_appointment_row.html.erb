<tr id="<%= dom_id(appointment, :index_row) %>">
  <td><%= appointment.date&.strftime('%d/%m/%Y') rescue appointment.date %></td>
  <td><strong><%= appointment.hour&.strftime('%H:%M') %></strong></td>
  <td><strong><%= appointment.patient&.user&.name %> <%= appointment.patient&.user&.last_name %></strong></td>
  <td><%= appointment.reason_for_consultation.presence || "—" %></td>
  <td class="text-center">
    <span class="status-pill <%= appointment.status %>"><%= appointment.status.to_s.humanize %></span>
  </td>
  <td class="text-center">
    <div style="display:flex;gap:6px;justify-content:center;flex-wrap:wrap;">
      <% if appointment.status == "pendiente" %>
        <%= button_to "Aceptar",
                      confirm_doctors_appointment_path(appointment),
                      method: :patch,
                      class: "btn-panel-success",
                      style: "padding:5px 10px;font-size:.8rem;" %>
        <%= button_to "Rechazar",
                      cancel_doctors_appointment_path(appointment),
                      method: :patch,
                      class: "btn-panel-danger",
                      style: "padding:5px 10px;font-size:.8rem;" %>
      <% end %>
      <%= link_to "Ver", doctors_appointment_path(appointment), class: "btn-panel-link" %>
    </div>
  </td>
</tr>
