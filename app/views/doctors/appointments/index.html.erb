<% content_for :page_title do %>
  Doctor · Mis Citas
<% end %>

<% pending = @appointments.select { |a| a.status == "pendiente" } %>
<% completed = @appointments.select { |a| a.status == "completado" } %>
<% cancelled = @appointments.select { |a| a.status == "cancelado" } %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-calendar"></i> Citas</span>
    <h1 class="panel-page-title">Mis citas asignadas</h1>
    <p class="panel-page-description">Acepta, rechaza y gestiona todas tus consultas.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Dashboard", doctors_dashboard_path, class: "btn-panel-ghost" %>
    <%= link_to "Mi calendario", doctors_calendars_path, class: "btn-panel-ghost" %>
  </div>
</div>

<!-- KPIs -->
<div class="panel-metrics">
  <div class="panel-metric">
    <p class="panel-metric__value"><%= @appointments.size %></p>
    <p class="panel-metric__label">Total citas</p>
  </div>
  <div class="panel-metric panel-metric--warning">
    <p class="panel-metric__value"><%= pending.size %></p>
    <p class="panel-metric__label">Pendientes</p>
  </div>
  <div class="panel-metric panel-metric--success">
    <p class="panel-metric__value"><%= completed.size %></p>
    <p class="panel-metric__label">Completadas</p>
  </div>
  <div class="panel-metric panel-metric--danger">
    <p class="panel-metric__value"><%= cancelled.size %></p>
    <p class="panel-metric__label">Canceladas</p>
  </div>
</div>

<div class="panel-card">
  <% if @appointments.any? %>
    <div class="panel-table-wrapper">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Paciente</th>
            <th>Motivo</th>
            <th class="text-center">Estado</th>
            <th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @appointments.each do |appt| %>
            <tr id="<%= dom_id(appt, :index_row) %>">
              <td><%= appt.date&.strftime('%d/%m/%Y') %></td>
              <td><strong><%= appt.hour&.strftime('%H:%M') %></strong></td>
              <td>
                <strong><%= appt.patient&.user&.name %> <%= appt.patient&.user&.last_name %></strong>
              </td>
              <td><%= appt.reason_for_consultation.presence || "—" %></td>
              <td class="text-center">
                <span class="status-pill <%= appt.status %>"><%= appt.status&.humanize %></span>
              </td>
              <td class="text-center">
                <div style="display:flex;gap:6px;justify-content:center;flex-wrap:wrap;">
                  <% if appt.status == "pendiente" %>
                    <%= button_to "Aceptar",
                                  confirm_doctors_appointment_path(appt),
                                  method: :patch,
                                  class: "btn-panel-success",
                                  style: "padding:6px 12px;font-size:.8rem;" %>
                    <%= button_to "Rechazar",
                                  cancel_doctors_appointment_path(appt),
                                  method: :patch,
                                  class: "btn-panel-danger",
                                  style: "padding:6px 12px;font-size:.8rem;" %>
                  <% end %>
                  <%= link_to "Ver", doctors_appointment_path(appt), class: "btn-panel-link" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div style="text-align:center;padding:48px 0;color:#aaa;">
      <i class="fa fa-calendar" style="font-size:2.5rem;margin-bottom:12px;display:block;"></i>
      <p style="margin:0;">No tienes citas asignadas todavía.</p>
    </div>
  <% end %>
</div>
