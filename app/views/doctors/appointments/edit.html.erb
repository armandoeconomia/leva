<% content_for :page_title do %>
  Doctor · Editar Cita
<% end %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-calendar-pen"></i> Citas</span>
    <h1 class="panel-page-title">Editar cita</h1>
    <p class="panel-page-description">Actualiza fecha, hora, motivo o estado de la consulta.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Ver cita", doctors_appointment_path(@appointment), class: "btn-panel-ghost" %>
    <%= link_to "Volver al listado", doctors_appointments_path, class: "btn-panel-ghost" %>
  </div>
</div>

<div class="panel-card">
  <%= form_with model: [:doctors, @appointment], local: true, html: { class: "panel-form" } do |form| %>
    <div class="panel-form-grid">
      <div>
        <%= form.label :date, "Fecha" %>
        <%= form.date_field :date %>
      </div>
      <div>
        <%= form.label :hour, "Hora" %>
        <%= form.time_field :hour %>
      </div>
    </div>

    <div>
      <%= form.label :reason_for_consultation, "Motivo de la consulta" %>
      <%= form.text_area :reason_for_consultation, rows: 3, placeholder: "Describe el motivo de la consulta" %>
    </div>

    <div>
      <%= form.label :status, "Estado" %>
      <%= form.select :status, Appointment.statuses.keys.map { |s| [s.humanize, s] }, { prompt: "Selecciona estado" } %>
    </div>

    <div class="panel-form-actions">
      <%= form.submit "Guardar cambios", class: "btn-panel-primary" %>
      <%= link_to "Cancelar", doctors_appointments_path, class: "btn-panel-ghost" %>
    </div>
  <% end %>
</div>
