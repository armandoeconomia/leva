<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-calendar-xmark"></i> Citas</span>
    <h1 class="panel-page-title">Cita eliminada</h1>
    <p class="panel-page-description">La cita fue eliminada del sistema.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Volver al listado", doctors_appointments_path, class: "btn-panel-ghost" %>
  </div>
</div>

<div class="panel-card" style="text-align:center;padding:48px;">
  <i class="fa fa-trash-can" style="font-size:3rem;color:#e74c3c;margin-bottom:16px;display:block;opacity:.6;"></i>
  <p style="color:#888;margin-bottom:24px;">Si necesitas recrearla, agenda una nueva cita con los datos correctos.</p>
  <div style="display:flex;justify-content:center;gap:10px;">
    <%= link_to "Mis citas", doctors_appointments_path, class: "btn-panel-primary" %>
    <%= link_to "Dashboard", doctors_dashboard_path, class: "btn-panel-ghost" %>
  </div>
</div>
