<% appt = @appointment %>
<% patient = appt.patient %>

<div class="admin-shell" style="padding: 32px 40px 48px; max-width: 900px; margin: 0 auto;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= link_to doctors_appointment_path(appt), class: "btn-leva-circle", aria: { label: "Volver a la cita" } do %>
      <i class="fa fa-arrow-left"></i>
    <% end %>
    <span class="status-pill <%= appt.status %>"><%= appt.status.to_s.titleize %></span>
  </div>

  <div class="admin-page-header">
    <div>
      <span class="page-eyebrow">Notas</span>
      <h1 class="admin-page-title">Registrar notas de la cita</h1>
      <p class="admin-page-description">
        Guarda diagnóstico, tratamiento y prescripción de la consulta.
      </p>
    </div>
  </div>

  <section class="admin-card mt-4" style="border-radius: 16px; box-shadow: 0 18px 32px rgba(0,0,0,0.06); padding: 22px;">
    <div class="admin-card__header">
      <div>
        <p class="page-eyebrow">Paciente</p>
        <h2 class="admin-card__title"><%= patient&.user&.name || "Paciente" %></h2>
        <p class="admin-card__description"><%= l(appt.date, format: '%d %b %Y') rescue appt.date %> · <%= appt.hour&.strftime('%H:%M') || appt.hour %></p>
      </div>
    </div>
    <div class="admin-card__body">
      <%= form_with model: @history, url: save_notes_doctors_appointment_path(appt), method: :post do |f| %>
        <div class="mb-3">
          <%= f.label :diagnosis, "Diagnóstico", class: "form-label" %>
          <%= f.text_area :diagnosis, class: "form-control", rows: 3, placeholder: "Escribe el diagnóstico" %>
        </div>
        <div class="mb-3">
          <%= f.label :treatment, "Tratamiento", class: "form-label" %>
          <%= f.text_area :treatment, class: "form-control", rows: 3, placeholder: "Plan de tratamiento" %>
        </div>
        <div class="mb-3">
          <%= f.label :prescription, "Prescripción", class: "form-label" %>
          <%= f.text_area :prescription, class: "form-control", rows: 3, placeholder: "Medicamentos e indicaciones" %>
        </div>
        <div class="d-flex gap-2">
          <%= link_to "Cancelar", doctors_appointment_path(appt), class: "btn-leva-plain" %>
          <%= f.submit "Guardar notas", class: "btn-leva-primary" %>
        </div>
      <% end %>
    </div>
  </section>
</div>
