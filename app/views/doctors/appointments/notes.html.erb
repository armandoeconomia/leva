<% content_for :page_title do %>
  Doctor · Notas de Cita
<% end %>

<% appt = @appointment %>
<% patient = appt.patient %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-notes-medical"></i> Citas</span>
    <h1 class="panel-page-title">Notas de la cita</h1>
    <p class="panel-page-description">Guarda diagnóstico, tratamiento y prescripción de esta consulta.</p>
  </div>
  <div class="d-flex gap-2">
    <span class="status-pill <%= appt.status %>"><%= appt.status.to_s.titleize %></span>
    <%= link_to "Ver cita", doctors_appointment_path(appt), class: "btn-panel-ghost" %>
  </div>
</div>

<div class="panel-card">
  <div class="panel-card__header">
    <div>
      <span class="panel-eyebrow"><i class="fa fa-user"></i> Paciente</span>
      <h2 class="panel-card__title"><%= patient&.user&.name || "Paciente" %></h2>
      <p class="panel-card__description">
        <%= l(appt.date, format: '%d %b %Y') rescue appt.date %> · <%= appt.hour&.strftime('%H:%M') || appt.hour %>
      </p>
    </div>
  </div>

  <%= form_with model: @history, url: save_notes_doctors_appointment_path(appt), method: :post, html: { class: "panel-form" } do |f| %>
    <div>
      <%= f.label :diagnosis, "Diagnóstico" %>
      <%= f.text_area :diagnosis, rows: 3, placeholder: "Escribe el diagnóstico clínico" %>
    </div>
    <div>
      <%= f.label :treatment, "Tratamiento" %>
      <%= f.text_area :treatment, rows: 3, placeholder: "Plan de tratamiento a seguir" %>
    </div>
    <div>
      <%= f.label :prescription, "Prescripción" %>
      <%= f.text_area :prescription, rows: 3, placeholder: "Medicamentos e indicaciones" %>
    </div>
    <div class="panel-form-actions">
      <%= f.submit "Guardar notas", class: "btn-panel-primary" %>
      <%= link_to "Cancelar", doctors_appointment_path(appt), class: "btn-panel-ghost" %>
    </div>
  <% end %>
</div>
