<tr id="<%= dom_id(appointment, :dashboard_row) %>">
  <td><%= appointment.date&.strftime('%d %b %Y') %></td>
  <td><%= appointment.hour&.strftime('%H:%M') %></td>
  <td><strong><%= appointment.patient&.user&.name || "Paciente" %></strong></td>
  <td class="text-center align-middle"><span class="status-pill <%= appointment.status %>"><%= appointment.status.to_s.titleize %></span></td>
  <td class="text-center align-middle">
    <div class="d-flex gap-2 justify-content-center flex-wrap appointment-actions">
      <%= link_to "Abrir", doctors_appointment_path(appointment), class: "btn-leva-ghost", style: "padding: 8px 14px; border-radius: 12px;" %>
      <%= link_to "Aceptar",
                  confirm_doctors_appointment_path(appointment),
                  method: :patch,
                  data: { turbo_stream: true },
                  class: "btn-leva-primary",
                  style: "padding: 8px 14px; border-radius: 12px;" %>
      <%= link_to "Rechazar",
                  cancel_doctors_appointment_path(appointment),
                  method: :patch,
                  data: { turbo_stream: true },
                  class: "btn-leva-ghost",
                  style: "padding: 8px 14px; border-radius: 12px; background: rgba(255,202,58,0.18); color: #2A2A2A;" %>
    </div>
  </td>
</tr>
