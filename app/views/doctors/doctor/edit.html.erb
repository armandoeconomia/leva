<% content_for :page_title do %>
  Doctor · Editar Perfil
<% end %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-user-pen"></i> Perfil</span>
    <h1 class="panel-page-title">Editar perfil</h1>
    <p class="panel-page-description">Actualiza tus datos personales y profesionales.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Ver perfil", doctors_doctor_path, class: "btn-panel-ghost" %>
  </div>
</div>

<div class="panel-card">
  <%= form_with model: [:doctors, @doctor], local: true, html: { class: "panel-form" } do |f| %>
    <div class="panel-form-grid">
      <div>
        <%= f.label :user_name, "Nombre" %>
        <%= text_field_tag "doctor[user_attributes][name]", @doctor.user&.name, placeholder: "Nombre de pila" %>
      </div>
      <div>
        <%= f.label :user_last_name, "Apellido" %>
        <%= text_field_tag "doctor[user_attributes][last_name]", @doctor.user&.last_name, placeholder: "Apellidos" %>
      </div>
    </div>

    <div class="panel-form-grid">
      <div>
        <%= f.label :user_email, "Correo" %>
        <%= email_field_tag "doctor[user_attributes][email]", @doctor.user&.email, placeholder: "correo@leva.com" %>
      </div>
      <div>
        <%= f.label :user_phone_number, "Teléfono" %>
        <%= text_field_tag "doctor[user_attributes][phone_number]", @doctor.user&.phone_number, placeholder: "+57 300 000 0000" %>
      </div>
    </div>

    <div class="panel-form-grid">
      <div>
        <%= f.label :medical_registration, "Registro médico" %>
        <%= f.text_field :medical_registration, placeholder: "Número de colegiado" %>
      </div>
      <div>
        <%= f.label :speciality, "Especialidad" %>
        <%= f.select :speciality, Doctor.specialities.keys.map { |s| [s.humanize, s] }, { prompt: "Selecciona especialidad" } %>
      </div>
    </div>

    <div>
      <%= f.label :medical_institute_id, "Instituto médico" %>
      <%= f.collection_select :medical_institute_id, MedicalInstitute.all, :id, :name, { prompt: "Selecciona un instituto" } %>
    </div>

    <div class="panel-form-actions">
      <%= f.submit "Guardar cambios", class: "btn-panel-primary" %>
      <%= link_to "Cancelar", doctors_doctor_path, class: "btn-panel-ghost" %>
    </div>
  <% end %>
</div>
