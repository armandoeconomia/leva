<% content_for :page_title do %>
  Doctor · Mi Perfil
<% end %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-user-doctor"></i> Perfil</span>
    <h1 class="panel-page-title">Mi perfil</h1>
    <p class="panel-page-description">Revisa y actualiza tus datos personales y profesionales.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Editar perfil", edit_doctors_doctor_path, class: "btn-panel-primary" %>
    <%= link_to "Dashboard", doctors_dashboard_path, class: "btn-panel-ghost" %>
  </div>
</div>

<div class="panel-card">
  <div class="panel-card__header">
    <span class="panel-eyebrow"><i class="fa fa-id-badge"></i> Datos personales</span>
    <span class="status-pill completado"><%= @doctor.speciality&.titleize || "Sin especialidad" %></span>
  </div>

  <div class="panel-details">
    <div class="panel-detail-item">
      <p class="panel-detail-label">Nombre</p>
      <p class="panel-detail-value"><%= [@doctor.user&.name, @doctor.user&.last_name].compact.join(" ") %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Correo</p>
      <p class="panel-detail-value"><%= @doctor.user&.email || "Sin email" %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Teléfono</p>
      <p class="panel-detail-value"><%= @doctor.user&.phone_number.presence || "Sin teléfono" %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Registro médico</p>
      <p class="panel-detail-value"><%= @doctor.medical_registration.presence || "No especificado" %></p>
    </div>
    <div class="panel-detail-item panel-detail-item--full">
      <p class="panel-detail-label">Instituto médico</p>
      <% if @doctor.medical_institute %>
        <p class="panel-detail-value"><%= @doctor.medical_institute.name %></p>
        <p style="color:#888;font-size:.875rem;margin:2px 0 0;"><%= @doctor.medical_institute.address.presence || "Sin dirección registrada" %></p>
      <% else %>
        <p class="panel-detail-value" style="opacity:.5;">Sin instituto asignado</p>
      <% end %>
    </div>
  </div>
</div>
