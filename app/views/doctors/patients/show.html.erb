<% content_for :page_title do %>
  Doctor · Paciente
<% end %>

<% patient = @patient %>
<% histories = patient&.medical_histories&.order(registration_date: :desc) || [] %>
<% latest_history = histories.first %>

<% if patient.nil? %>
  <div style="text-align:center;padding:64px 0;color:#aaa;">
    <i class="fa fa-user-slash" style="font-size:2.5rem;margin-bottom:12px;display:block;"></i>
    <p style="margin:0;">No se encontró al paciente.</p>
    <%= link_to "Volver a mis pacientes", doctors_patients_path, class: "btn-panel-ghost", style: "margin-top:16px;display:inline-flex;" %>
  </div>
<% else %>

<div class="panel-page-header">
  <div>
    <span class="panel-eyebrow"><i class="fa fa-user"></i> Pacientes</span>
    <h1 class="panel-page-title"><%= patient.user&.name %> <%= patient.user&.last_name %></h1>
    <p class="panel-page-description">Historial y datos clínicos del paciente.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Ver citas", doctors_appointments_path, class: "btn-panel-ghost" %>
    <%= link_to "Mis pacientes", doctors_patients_path, class: "btn-panel-ghost" %>
  </div>
</div>

<div class="panel-card">
  <div class="panel-card__header">
    <div>
      <span class="panel-eyebrow"><i class="fa fa-id-card"></i> Datos del paciente</span>
    </div>
    <span class="status-pill <%= patient.blood_type.present? ? 'completado' : 'pendiente' %>">
      <%= patient.blood_type.present? ? patient.blood_type.upcase : "Sin tipo de sangre" %>
    </span>
  </div>

  <div class="panel-details">
    <div class="panel-detail-item">
      <p class="panel-detail-label">Correo</p>
      <p class="panel-detail-value"><%= patient.user&.email || "Sin email" %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Teléfono</p>
      <p class="panel-detail-value"><%= patient.user&.phone_number.presence || "Sin teléfono" %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Estado civil</p>
      <p class="panel-detail-value"><%= patient.marital_status&.humanize || "N/D" %></p>
    </div>
    <div class="panel-detail-item">
      <p class="panel-detail-label">Contacto de emergencia</p>
      <p class="panel-detail-value"><%= patient.emergency_contact.presence || "N/D" %></p>
    </div>
  </div>
</div>

<% if latest_history.present? %>
<div class="panel-card">
  <div class="panel-card__header">
    <div>
      <span class="panel-eyebrow"><i class="fa fa-notes-medical"></i> Último registro</span>
      <h2 class="panel-card__title"><%= latest_history.registration_date&.strftime('%d %b %Y') || "Sin fecha" %></h2>
      <p class="panel-card__description">Diagnóstico y tratamiento más reciente.</p>
    </div>
    <span class="status-pill completado"><%= latest_history.doctor&.user&.name || "Doctor" %></span>
  </div>

  <div class="panel-details">
    <div class="panel-detail-item panel-detail-item--full">
      <p class="panel-detail-label">Diagnóstico</p>
      <p class="panel-detail-value"><%= latest_history.diagnosis.presence || "Sin diagnóstico" %></p>
    </div>
    <div class="panel-detail-item panel-detail-item--full">
      <p class="panel-detail-label">Tratamiento</p>
      <p class="panel-detail-value"><%= latest_history.treatment.presence || "Sin tratamiento" %></p>
    </div>
    <div class="panel-detail-item panel-detail-item--full">
      <p class="panel-detail-label">Prescripción</p>
      <p class="panel-detail-value"><%= latest_history.prescription.presence || "Sin prescripción" %></p>
    </div>
  </div>
</div>
<% end %>

<div class="panel-card">
  <div class="panel-card__header">
    <div>
      <span class="panel-eyebrow"><i class="fa fa-list-alt"></i> Historiales</span>
      <h2 class="panel-card__title">Historiales médicos</h2>
      <p class="panel-card__description">Selecciona cualquier registro para ver su detalle.</p>
    </div>
  </div>

  <% if histories.any? %>
    <div class="panel-table-wrapper">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Doctor</th>
            <th>Diagnóstico</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% histories.each do |history| %>
            <tr>
              <td><%= history.registration_date&.strftime('%d %b %Y') || "Sin fecha" %></td>
              <td><%= history.doctor&.user&.name || "Doctor" %></td>
              <td style="color:#888;"><%= truncate(history.diagnosis, length: 80) %></td>
              <td>
                <%= link_to "Ver detalle", doctors_patient_medical_history_path(patient, history), class: "btn-panel-link" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div style="text-align:center;padding:32px 0;color:#aaa;">
      <i class="fa fa-notes-medical" style="font-size:2rem;margin-bottom:10px;display:block;"></i>
      <p style="margin:0;">Este paciente no tiene historiales médicos registrados.</p>
    </div>
  <% end %>
</div>

<% end %>
